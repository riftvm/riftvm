# frozen_string_literal: true

# Ruby tooling for this repository. scripts/integrate-omarchy-sources.rb needs
# xcodeproj to add new source files to the Xcode targets.
#
#   bundle install && bundle exec ruby scripts/integrate-omarchy-sources.rb
#
# or, without Bundler: gem install xcodeproj --version '~> 1.27'

source "https://rubygems.org"

gem "xcodeproj", "~> 1.27"
