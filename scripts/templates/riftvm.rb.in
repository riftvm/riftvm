# typed: strict
# frozen_string_literal: true

cask "riftvm" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/riftvm/riftvm/releases/download/v#{version}/RiftVM-#{version}.zip"
  name "RiftVM"
  desc "Simple native virtual machines for Apple silicon Macs"
  homepage "https://riftvm.github.io"

  depends_on arch: :arm64
  depends_on macos: :any

  # Homebrew does not yet enumerate macOS 27. Enforce the host minimum
  # before installing instead of advertising support for an older release.
  preflight do
    unless MacOS.version.to_s.split(".").first.to_i >= 27
      raise "RiftVM requires macOS 27 or later."
    end
  end

  app "RiftVM.app"
  binary "#{appdir}/RiftVM.app/Contents/Helpers/riftvm"

  zap trash: [
    "~/Library/Application Support/RiftVM",
    "~/Library/Preferences/com.riftvm.app.plist",
    "~/Library/Saved Application State/com.riftvm.app.savedState",
  ]
end
