    "RiftVM" : {

    },
    "RiftVM will download the selected image if needed, then create and install your virtual machine. You can leave this window open and wait once." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RiftVM 会在需要时下载所选映像，然后创建并安装虚拟机。保持此窗口打开，等待一次即可。"
          }
        }
      }
    },
    "RiftVM will keep a recovery point before replacing the machine state." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "替换虚拟机状态前，RiftVM 会保留一个恢复点。"
          }
        }
      }
    },
    "RiftVM will save the virtual machine’s current state, stop it, and then close this window. You can resume from the same state next time." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RiftVM 将保存虚拟机的当前状态并将其停止，然后关闭此窗口。下次可以从相同状态继续运行。"
          }
        }
      }
    },
