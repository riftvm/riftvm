    "%@ RiftVM will ask the guest to shut down, force stop only if it does not respond, and then close this window." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ RiftVM 将请求客体系统关机，仅在其无响应时强制停止，然后关闭此窗口。"
          }
        }
      }
    },
