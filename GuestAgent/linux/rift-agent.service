[Unit]
Description=RiftVM Guest Agent
After=network.target

[Service]
Type=simple
RuntimeDirectory=rift-agent
RuntimeDirectoryMode=0755
ExecStart=/usr/local/sbin/rift-agent --config /etc/rift-agent/config.json
Restart=always
RestartSec=2
User=root
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
