    "Automatic account creation requires a macOS 27 or later guest. The selected restore image contains macOS %@. Choose a macOS 27 or later IPSW." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动创建账户要求客体系统为 macOS 27 或更高版本。所选恢复映像包含 macOS %@。请选择 macOS 27 或更高版本的 IPSW。"
          }
        }
      }
    },
    "Begin the verified restore transaction." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
